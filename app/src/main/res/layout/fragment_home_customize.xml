<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_custom_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/home_custom_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/home_custom_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:paddingStart="2dp"
            android:paddingEnd="8dp"
            android:text="@string/interface_diy"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/home_custom_refresh"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:text="@string/home_custom_refresh"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/home_custom_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/home_custom_fullscreen"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.sii.browser.ui.ScaledPreviewLayout
        android:id="@+id/home_custom_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@color/bg_page"
        android:clipToOutline="true"
        android:elevation="2dp" />

    <View
        android:id="@+id/home_custom_resize_handle"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:background="@color/bg_page" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/toolbar_bg"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_custom_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/home_custom_controls_scroll"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@color/bg_page"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/home_custom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="12dp" />
    </ScrollView>
</LinearLayout>
