<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toolbar_bg">

    <!-- 主体：地址栏 + 内容 + 底部工具栏（垂直排列） -->
    <LinearLayout
        android:id="@+id/browser_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/tab_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_bg"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tab_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/address_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/site_info_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/site_info_title"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_site_info"
                android:tint="@color/icon_primary" />

            <EditText
                android:id="@+id/address_input"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:includeFontPadding="false"
                android:inputType="textUri"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/refresh_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_refresh"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tb_refresh"
                android:tint="@color/icon_primary" />

            <!-- 新版编辑态：隐藏站点图标/刷新，显示取消 -->
            <TextView
                android:id="@+id/modern_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@android:string/cancel"
                android:textColor="?android:attr/colorAccent"
                android:textSize="13.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="?android:attr/colorAccent"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/search_toolbar_scroll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/toolbar_bg"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/search_toolbar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/webview_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/home_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/find_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="8dp"
                android:background="@drawable/bg_find_bar"
                android:elevation="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/find_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/menu_find"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/find_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/find_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:text="‹"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/find_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:text="›"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/find_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:text="✕"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 下载提示条：有任务进行中/刚完成时显示，点击跳下载页 -->
            <LinearLayout
                android:id="@+id/download_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_find_bar"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/download_bar_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/download_bar_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/download_bar_view"
                    android:textColor="?android:attr/colorAccent"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 朗读浮条（对应 index.html #ttsBar） -->
            <LinearLayout
                android:id="@+id/tts_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="8dp"
                android:background="@drawable/bg_find_bar"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tts_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tts_speaking"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tts_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/tts_rate"
                    android:textColor="?android:attr/colorAccent"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tts_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/tts_stop"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <View
                android:id="@+id/page_loading_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_page"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sniff_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="10dp"
                android:background="@drawable/bg_menu_panel"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sniff_prompt_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sniff_prompt_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_accent_soft"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/sniff_play"
                    android:textColor="?android:attr/colorAccent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sniff_prompt_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/sniff_download"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/sniff_prompt_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/sniff_prompt_close"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/toolbar_bg"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_count_button"
                style="@style/ToolbarButton">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/tabs_title"
                        android:src="@drawable/ic_tb_tabs" />

                    <TextView
                        android:id="@+id/tab_count"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingTop="5dp"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textSize="8.6sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView style="@style/ToolbarLabel" android:text="@string/tab_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/back_button"
                style="@style/ToolbarButton">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_back"
                    android:src="@drawable/ic_tb_back" />
                <TextView style="@style/ToolbarLabel" android:text="@string/nav_back" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/forward_button"
                style="@style/ToolbarButton">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_forward"
                    android:src="@drawable/ic_tb_forward" />
                <TextView style="@style/ToolbarLabel" android:text="@string/nav_forward" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_button"
                style="@style/ToolbarButton">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/menu_home"
                    android:src="@drawable/ic_tb_home" />
                <TextView style="@style/ToolbarLabel" android:text="@string/menu_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_button"
                style="@style/ToolbarButton">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/ic_tb_menu" />
                <TextView style="@style/ToolbarLabel" android:text="@string/menu" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 夜间滤镜：覆盖网页区域的轻量遮罩 -->
    <View
        android:id="@+id/night_filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- 翻译进度与控制（悬浮在内容上方） -->
    <TextView
        android:id="@+id/translate_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_translate_status"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 翻译悬浮按钮：未翻译/翻译中/原文译文切换 -->
    <TextView
        android:id="@+id/translate_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_translate_fab"
        android:elevation="6dp"
        android:gravity="center"
        android:text="@string/translate_fab_start"
        android:textColor="?android:attr/colorAccent"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 新版底部悬浮底栏（经典模式隐藏）：地址胶囊 + 图标工具行 -->
    <LinearLayout
        android:id="@+id/modern_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:clipChildren="false"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/modern_quick_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/modern_main_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/modern_address_host"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clipChildren="false" />

            <LinearLayout
                android:id="@+id/modern_tool_row"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:background="@android:color/transparent"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- 标签面板（覆盖层，不参与主体排版） -->
    <FrameLayout
        android:id="@+id/tabs_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        android:visibility="gone">

        <View
            android:id="@+id/tabs_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mask" />

        <LinearLayout
            android:id="@+id/tabs_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_modern_sheet"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/tabs_handle"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@android:color/transparent">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sheet_handle" />
            </FrameLayout>

            <TextView
                android:id="@+id/tabs_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/tabs_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/tabs_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:paddingTop="0dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabs_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/tabs_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tabs_new"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="@string/menu_new_tab"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tabs_undo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="@string/tab_undo"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 菜单浮层（覆盖层，不参与主体排版） -->
    <FrameLayout
        android:id="@+id/menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone">

        <View
            android:id="@+id/menu_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mask" />

        <LinearLayout
            android:id="@+id/menu_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_modern_sheet"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/menu_handle"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@android:color/transparent">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sheet_handle" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/menu_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/menu_open_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/settings"
                    android:textColor="?android:attr/colorAccent"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 固定操作：用户可定制的快捷项 -->
            <HorizontalScrollView
                android:id="@+id/menu_fixed_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/menu_toggles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </HorizontalScrollView>

            <!-- 分隔线 -->
            <View
                android:id="@+id/menu_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="8dp"
                android:background="@color/line" />

            <!-- 其余菜单项：4 列纵向网格，内容多时滚动 -->
            <ScrollView
                android:id="@+id/menu_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/menu_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- 左右滑动样式：两行、横向滚动 -->
            <HorizontalScrollView
                android:id="@+id/menu_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/menu_grid_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- 全屏视频容器（onShowCustomView 时显示） -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
