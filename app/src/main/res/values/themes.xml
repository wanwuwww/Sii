    <style name="SiiDialogModernPurple" parent="SiiDialogModern">
        <item name="android:colorAccent">@color/accent_purple</item>
        <item name="colorAccent">@color/accent_purple</item>
    </style>

    <style name="ThemeOverlay.Sii.DialogModern" parent="">
        <item name="alertDialogTheme">@style/SiiDialogModern</item>
        <item name="android:alertDialogTheme">@style/SiiDialogModern</item>
    </style>
    <style name="ThemeOverlay.Sii.DialogModernGreen" parent="">
        <item name="alertDialogTheme">@style/SiiDialogModernGreen</item>
        <item name="android:alertDialogTheme">@style/SiiDialogModernGreen</item>
    </style>
    <style name="ThemeOverlay.Sii.DialogModernOrange" parent="">
        <item name="alertDialogTheme">@style/SiiDialogModernOrange</item>
        <item name="android:alertDialogTheme">@style/SiiDialogModernOrange</item>
    </style>
    <style name="ThemeOverlay.Sii.DialogModernPurple" parent="">
        <item name="alertDialogTheme">@style/SiiDialogModernPurple</item>
        <item name="android:alertDialogTheme">@style/SiiDialogModernPurple</item>
    </style>

    <style name="ThemeOverlay.Sii.DialogClassic" parent="">
        <item name="alertDialogTheme">@style/SiiDialog</item>
        <item name="android:alertDialogTheme">@style/SiiDialog</item>
    </style>
    <style name="ThemeOverlay.Sii.DialogClassicGreen" parent="">
        <item name="alertDialogTheme">@style/SiiDialogGreen</item>
        <item name="android:alertDialogTheme">@style/SiiDialogGreen</item>
